# Google OAuth "Web application" client ID (Google Cloud Console > APIs & Services > Credentials).
# Add http://localhost:5173 (and your production origin) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Leave empty in dev (uses the Vite proxy). Set to e.g. https://api.yourdomain.com in production.
VITE_API_URL=
