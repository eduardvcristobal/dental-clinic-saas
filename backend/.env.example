# Database. Use a restricted dental_app role for application traffic.
DB_URL=jdbc:postgresql://localhost:5432/dental
DB_APP_USER=dental_app
DB_APP_PASSWORD=replace-with-local-secret
# Flyway owner-only credentials.
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=replace-with-local-secret

# Google OAuth web client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Generate a unique random value with at least 32 UTF-8 bytes.
APP_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
APP_COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=http://localhost:5173
# Per-instance auth throttles; use a shared gateway limit when running multiple replicas.
APP_AUTH_LOGIN_RPM=10
APP_AUTH_REFRESH_RPM=30
# Leave blank outside deterministic integration tests; production uses Google's JWKS endpoint.
GOOGLE_JWK_SET_URI=
